# =============================================================================
# LLM Inference Stack Configuration
# =============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env

# --- Model Configuration ---
MODEL_NAME=Qwen/Qwen2.5-3B-Instruct-AWQ
# Max model length (tokens). Adjust based on your VRAM.
MAX_MODEL_LEN=4096
# Quantization method (awq, gptq, or leave empty for unquantized)
QUANTIZATION=awq
# GPU memory utilization (0.0 - 1.0). Leave headroom for KV cache.
GPU_MEMORY_UTILIZATION=0.90

# --- vLLM Server ---
VLLM_PORT=8000
# Number of tensor parallel GPUs (1 for single GPU)
TENSOR_PARALLEL_SIZE=1
# Enable prefix caching for repeated prompt prefixes
ENABLE_PREFIX_CACHING=true

# --- Hugging Face (optional, for gated models) ---
# HF_TOKEN=hf_your_token_here

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# --- Prometheus ---
PROMETHEUS_PORT=9090
